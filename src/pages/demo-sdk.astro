---
import Layout from '../layouts/Layout.astro'
import Experiment from '../components/Experiment.astro'
import Variant from '../components/Variant.astro'
---

<Layout title="Demo SDK" variant="SDK — /demo-sdk">
  <main class="page">

    <div style="display:inline-block;background:#F5EDE0;color:#C96A3F;font-size:11px;font-weight:700;padding:5px 12px;border-radius:999px;margin-bottom:24px;letter-spacing:.5px">
      SDK EXPERIMENT · BUTTON STYLE
    </div>

    <h1>Same URL.<br/>Different button.</h1>

    <p class="subtitle">
      The server reads <code>searchParams</code> to assign a variant.
      No middleware, no cookies — just a URL parameter.
    </p>

    <Experiment id="bb1e7469-062c-4426-98ad-9b5ca8869f1b">

      <Variant slot="control">
        <div class="experiment-wrap">
          <p class="showing">Currently showing: <strong>Control — outlined button</strong></p>
          <a href="/thank-you" class="btn btn--outlined">Start free today</a>
        </div>
      </Variant>

      <Variant slot="b">
        <div class="experiment-wrap">
          <p class="showing">Currently showing: <strong>Variant B — filled button</strong></p>
          <a href="/thank-you" class="btn btn--filled">Start free today</a>
        </div>
      </Variant>

    </Experiment>

    <div class="try-box">
      <p class="try-label">Try both variants</p>
      <div class="try-links">
        <a href="/demo-sdk" class="try-control">Control (outlined)</a>
        <a href="/demo-sdk?utm_text=variation-1" class="try-b">Variant B (filled) →</a>
      </div>
    </div>

  </main>
</Layout>

<style>
  .page { max-width: 720px; margin: 0 auto; padding: 80px 40px; text-align: center; display: flex; flex-direction: column; gap: 32px; align-items: center; }

  h1 { font-size: clamp(32px, 5vw, 52px); font-weight: 800; letter-spacing: -1.5px; color: #0F2235; line-height: 1.1; }

  .subtitle { font-size: 17px; color: #6b7280; max-width: 480px; line-height: 1.6; }
  code { background: #F5EDE0; padding: 2px 6px; border-radius: 4px; font-size: 14px; }

  .experiment-wrap { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .showing { font-size: 13px; color: #9ca3af; }
  .showing strong { color: #0F2235; }

  .btn { display: inline-block; padding: 14px 36px; border-radius: 12px; font-weight: 700; font-size: 15px; text-decoration: none; }
  .btn--outlined { background: transparent; color: #C96A3F; border: 2px solid #C96A3F; }
  .btn--filled   { background: #C96A3F; color: #fff; }

  .try-box { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 16px; padding: 24px; text-align: left; width: 100%; }
  .try-label { font-size: 12px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 12px; }
  .try-links { display: flex; gap: 12px; flex-wrap: wrap; }
  .try-control { font-size: 13px; color: #0F2235; background: #fff; border: 1px solid #e5e7eb; padding: 6px 14px; border-radius: 8px; text-decoration: none; font-weight: 500; }
  .try-b { font-size: 13px; color: #fff; background: #C96A3F; padding: 6px 14px; border-radius: 8px; text-decoration: none; font-weight: 500; }
</style>
