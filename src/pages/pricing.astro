---
import Layout from '../layouts/Layout.astro'

const plans = [
  {
    name: 'Free', price: '$0', period: '/ forever',
    cta: 'Get started', popular: false,
    features: ['1 workspace', '3 experiments', 'Edge + SDK testing'],
  },
  {
    name: 'Starter', price: '$29', period: '/ per month',
    cta: 'Get started', popular: true,
    features: ['3 workspaces', 'Unlimited experiments', 'All analytics integrations', 'Email support'],
  },
  {
    name: 'Growth', price: '$79', period: '/ per month',
    cta: 'Get started', popular: false,
    features: ['Unlimited workspaces', 'Unlimited experiments', 'Priority support', 'Custom webhooks'],
  },
]
---

<Layout title="Pricing" variant="control — /pricing">
  <main class="page">

    <h1>Simple, transparent pricing</h1>
    <p class="subtitle">Start free. Scale when you're ready.</p>

    <div class="grid">
      {plans.map((plan) => (
        <div class:list={['plan', plan.popular && 'plan--popular']}>
          {plan.popular && <span class="popular-badge">Most popular</span>}
          <p class="plan__name">{plan.name}</p>
          <div class="plan__price-row">
            <span class="plan__price">{plan.price}</span>
            <span class="plan__period">{plan.period}</span>
          </div>
          <ul class="features">
            {plan.features.map(f => <li><span class="check">✓</span>{f}</li>)}
          </ul>
          <a href="/thank-you" class:list={['btn', plan.popular ? 'btn--primary' : 'btn--ghost']}>{plan.cta}</a>
        </div>
      ))}
    </div>

  </main>
</Layout>

<style>
  .page { max-width: 960px; margin: 0 auto; padding: 80px 40px; text-align: center; }

  h1 { font-size: 48px; font-weight: 800; letter-spacing: -1.5px; margin-bottom: 12px; color: #0F2235; }
  .subtitle { color: #6b7280; font-size: 17px; margin-bottom: 56px; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  .plan { border: 1px solid #e5e7eb; border-radius: 20px; padding: 32px; text-align: left; position: relative; background: #fff; }
  .plan--popular { background: #0F2235; border-color: #0F2235; }

  .popular-badge { position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: #C96A3F; color: #fff; font-size: 12px; font-weight: 700; padding: 5px 16px; border-radius: 999px; white-space: nowrap; }

  .plan__name   { font-size: 18px; font-weight: 700; color: #0F2235; margin-bottom: 8px; }
  .plan--popular .plan__name { color: #fff; }

  .plan__price-row { display: flex; align-items: baseline; gap: 6px; margin-bottom: 24px; }
  .plan__price  { font-size: 42px; font-weight: 800; color: #0F2235; }
  .plan--popular .plan__price { color: #fff; }
  .plan__period { font-size: 15px; color: #6b7280; }
  .plan--popular .plan__period { color: #9ca3af; }

  .features { list-style: none; font-size: 14px; color: #4b5563; display: flex; flex-direction: column; gap: 12px; margin: 0 0 28px; padding: 0; }
  .plan--popular .features { color: #d1d5db; }
  .features li { display: flex; align-items: center; gap: 10px; }
  .check { color: #C96A3F; font-weight: 700; }

  .btn { display: block; text-align: center; border-radius: 12px; padding: 12px 20px; font-size: 14px; font-weight: 600; text-decoration: none; }
  .btn--primary { background: #C96A3F; color: #fff; }
  .btn--ghost   { background: #FEF0E8; color: #C96A3F; }
</style>
